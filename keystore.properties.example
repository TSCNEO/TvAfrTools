# Signing credentials template.
#
# Copy to `keystore.properties` (root of your clone) and fill in your values.
# That file is git-ignored — never commit it, never paste it in a chat or issue.
#
# In CI, do NOT use this file: export the environment variables instead
# (KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD) and feed the
# keystore from a secret.
#
# storeFile may be absolute or relative to the module (app/).

storeFile=/absolute/path/to/your/release.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
