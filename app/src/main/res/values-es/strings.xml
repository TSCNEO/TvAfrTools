    <!-- AFR Section -->
    <string name="afr_section_title">Ajustar frecuencia de pantalla (AFR)</string>
    <string name="afr_section_desc">Cambia los Hz de tu TV para que coincidan exactamente con la película o serie y evitar tirones (judder 24p).</string>
    <string name="afr_opt_auto_streaming">Ajustar Hz automáticamente en apps de streaming</string>
    <string name="afr_opt_auto_streaming_desc">Cambia los Hz automáticamente al abrir Netflix, Disney+, Prime Video, etc.</string>
    <string name="afr_opt_fractional">Frecuencias fraccionales precisas (23.976p / 59.94p)</string>
    <string name="afr_opt_fractional_desc">Evita micro-tirones cada 41 segundos en películas grabadas a 23.976 fps.</string>
    <string name="afr_opt_25_to_50">Convertir 25 fps a 50 Hz (estándar europeo / TV en directo)</string>
    <string name="afr_opt_25_to_50_desc">Ideal para emisiones y aplicaciones europeas como DAZN o Movistar.</string>
    <string name="afr_opt_24_to_48">Duplicar 24 fps a 48 Hz (si tu TV lo admite)</string>
    <string name="afr_opt_24_to_48_desc">Reproducción 2:2 sin artefactos si tu televisor soporta 48 Hz.</string>
    <string name="afr_opt_pause_switch">Pausar brevemente durante el cambio de pantalla</string>
    <string name="afr_opt_pause_switch_desc">Pausa el vídeo 1.2 segundos para no perderte el inicio mientras la TV hace el cambio HDMI.</string>
    <string name="afr_opt_auto_restore">Volver a 60 Hz normales al salir al menú de la tele</string>
    <string name="afr_opt_auto_restore_desc">Garantiza que los menús de la tele y el launcher se muevan siempre fluidos a 60 Hz.</string>
    <string name="afr_btn_test_manual">Probar conmutación manual ahora</string>
    <string name="afr_btn_test_manual_desc">Abre el menú flotante interactivo para probar el cambio de Hz con el mando.</string>

