<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="#F59E0B"/><stroke android:width="2dp" android:color="#0F1014"/><corners android:radius="8dp"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#F59E0B"/><corners android:radius="8dp"/></shape></item>
    <item android:state_selected="true"><layer-list><item><shape><solid android:color="#22252D"/><corners android:radius="8dp"/></shape></item><item android:width="4dp" android:gravity="left"><shape><solid android:color="#F59E0B"/><corners android:radius="4dp"/></shape></item></layer-list></item>
    <item><shape><solid android:color="@android:color/transparent"/></shape></item>
</selector>
