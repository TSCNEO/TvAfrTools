<resources>
    <style name="Theme.TvAfrTools" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/cinema_amber</item>
        <item name="android:colorAccent">@color/cinema_amber</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/cinema_sidebar</item>
        <item name="android:windowBackground">@color/cinema_bg</item>
        <item name="android:alertDialogTheme">@style/Theme.TvAfrTools.Dialog</item>
    </style>
    <style name="Theme.TvAfrTools.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/cinema_amber</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:textColorPrimary">@color/cinema_text_title</item>
        <item name="android:textColorSecondary">@color/cinema_text_body</item>
    </style>
</resources>
