    <!-- AFR Section -->
    <string name="afr_section_title">Auto Frame Rate (AFR)</string>
    <string name="afr_section_desc">Match HDMI refresh rate to video fps to eliminate judder in 24p movies and streaming.</string>
    <string name="afr_opt_auto_streaming">Auto-match refresh rate in streaming apps</string>
    <string name="afr_opt_auto_streaming_desc">Automatically changes Hz when opening Netflix, Disney+, Prime Video, etc.</string>
    <string name="afr_opt_fractional">Precise fractional rates (23.976p / 59.94p)</string>
    <string name="afr_opt_fractional_desc">Avoids micro-stutter every 41 seconds on standard 24.000 Hz panels.</string>
    <string name="afr_opt_25_to_50">Convert 25 fps to 50 Hz (European TV / Live Sports)</string>
    <string name="afr_opt_25_to_50_desc">Optimal for European broadcasts and sports apps like DAZN or Movistar.</string>
    <string name="afr_opt_24_to_48">Double 24 fps to 48 Hz (if TV supports it)</string>
    <string name="afr_opt_24_to_48_desc">Smooth 2:2 pulldown without motion interpolation artifacts.</string>
    <string name="afr_opt_pause_switch">Brief pause during HDMI mode switch</string>
    <string name="afr_opt_pause_switch_desc">Pauses video for 1.2s to prevent missing the intro during HDMI handshake.</string>
    <string name="afr_opt_auto_restore">Restore 60 Hz when exiting to TV launcher</string>
    <string name="afr_opt_auto_restore_desc">Ensures system UI and launchers stay smooth at 60 Hz.</string>
    <string name="afr_btn_test_manual">Test manual switching now</string>
    <string name="afr_btn_test_manual_desc">Opens the floating selector to manually switch Hz with your remote.</string>

